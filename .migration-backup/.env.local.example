# ─── QA360 — Local Development Environment ───────────────────────────────────
# Copy to .env.local and fill in your values.
# This file is safe to commit. .env.local is git-ignored.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from https://app.supabase.com → Project Settings → API
# Leave empty to run in mock-data mode (no database required).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for the AI Test Case Generator feature.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Optional: Email Notifications ───────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@qa360.app
