# QA360 Backend - Express Server Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
# Railway automatically sets PORT. For local dev, default is 3001
PORT=3001

# CORS Configuration
# Comma-separated list of allowed origins. Use * for development only.
# Production: CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Frontend URL (for CORS and redirects)
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key

# Supabase Configuration (Database)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Playwright Configuration
# Railway Linux containers require chromium installation via postinstall script
# Leave empty - Playwright will use bundled browser after postinstall
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Node Environment
NODE_ENV=production

# Email Notifications (Optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@qa360.app

# Slack Notifications (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GitHub CI/CD Integration (Optional)
# GITHUB_TOKEN=your-github-token
