# ─── QA360 Environment Variables ─────────────────────────────────────────────
# Copy this file to .env.local (Next.js frontend) and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-side only.

# ─── Supabase (Database + Auth) ───────────────────────────────────────────────
# Get these from https://app.supabase.com → Project Settings → API
# Leave empty to run the app in mock-data mode (no database required).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OpenAI (AI Test Case Generator) ─────────────────────────────────────────
# For local development and Vercel deployment:
#   Get your key at https://platform.openai.com/api-keys
# On Replit:
#   AI_INTEGRATIONS_OPENAI_API_KEY and AI_INTEGRATIONS_OPENAI_BASE_URL are
#   injected automatically by the Replit AI integration — no key needed.
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Backend API (Express — deployed to Railway) ──────────────────────────────
# URL of the Express backend. Used by the legacy dashboard/ React app.
# Leave empty if you are only running the Next.js frontend.
NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app

# ─── Express Backend Server ───────────────────────────────────────────────────
# Port the Express server listens on (Railway sets PORT automatically).
PORT=8080

# Comma-separated list of allowed CORS origins for the Express backend.
# Use * to allow all origins (development only).
# Example: https://qa360.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Path to the Chromium executable used by Playwright.
# Leave empty to let Playwright find its bundled browser automatically.
# On Railway this is typically set by the Playwright installer.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# ─── Email Notifications (SMTP) ───────────────────────────────────────────────
# Used by the notification service to send test result alerts.
# Leave empty to disable email notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@qa360.app

# ─── Slack / Teams Notifications ─────────────────────────────────────────────
# Incoming webhook URLs for test result notifications.
# Leave empty to disable.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/xxx
