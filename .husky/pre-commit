#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run linting
echo "📝 Running linter..."
npm run lint || { echo "❌ Linting failed. Please fix errors before committing."; exit 1; }

# Run Playwright tests
echo "🧪 Running Playwright tests..."
npm test || { echo "❌ Tests failed. Please fix failing tests before committing."; exit 1; }

# Run visual regression tests for snapshot files
if git diff --cached --name-only | grep -q "playwright"; then
  echo "📸 Visual regression detected. Validating snapshots..."
  npm run test:visual || echo "⚠️  Visual test warning - review snapshots"
fi

echo "✅ All pre-commit checks passed!"
