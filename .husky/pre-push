#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running pre-push validation..."

# Run comprehensive test suite before pushing
echo "🧪 Running full test suite..."
npm test || { echo "❌ Tests failed. Push aborted."; exit 1; }

# Run linting
echo "📝 Validating code quality..."
npm run lint || { echo "❌ Linting failed. Push aborted."; exit 1; }

# Run critical tests
echo "🔴 Running critical tests..."
npm run test:critical || { echo "❌ Critical tests failed. Push aborted."; exit 1; }

echo "✅ All pre-push checks passed! Ready to push."
